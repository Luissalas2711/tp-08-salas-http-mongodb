<h2>Nueva Reserva de Sala</h2>

<% if (locals.errores && errores.length > 0) { %>
  <div role="alert" class="alert-errores">
    <p><strong>Por favor corrija los siguientes errores:</strong></p>
    <ul>
      <% errores.forEach(error => { %>
        <li><%= error %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<form action="/reservas" method="POST">
  <div>
    <label for="estudiante">Nombre del Estudiante:</label>
    <input 
      type="text" 
      id="estudiante" 
      name="estudiante" 
      value="<%= locals.valores && valores.estudiante ? valores.estudiante : '' %>"
    >
  </div>

  <div>
    <label for="email">Correo Electrónico:</label>
    <input 
      type="email" 
      id="email" 
      name="email" 
      value="<%= locals.valores && valores.email ? valores.email : '' %>"
    >
  </div>

  <div>
    <label for="sala">Sala:</label>
    <select id="sala" name="sala">
      <option value="">-- Seleccionar Sala --</option>
      <% salasPermitidas.forEach(sala => { %>
        <option 
          value="<%= sala %>" 
          <%= (locals.valores && valores.sala === sala) ? 'selected' : '' %>
        >
          <%= sala %>
        </option>
      <% }) %>
    </select>
  </div>

  <div>
    <label for="fecha">Fecha:</label>
    <input 
      type="date" 
      id="fecha" 
      name="fecha" 
      value="<%= locals.valores && valores.fecha ? valores.fecha : '' %>"
    >
  </div>

  <div>
    <label for="turno">Turno:</label>
    <select id="turno" name="turno">
      <option value="">-- Seleccionar Turno --</option>
      <% ['Mañana', 'Tarde', 'Noche'].forEach(t => { %>
        <option 
          value="<%= t %>" 
          <%= (locals.valores && valores.turno === t) ? 'selected' : '' %>
        >
          <%= t %>
        </option>
      <% }) %>
    </select>
  </div>

  <div>
    <label for="personas">Cantidad de Personas (1-6):</label>
    <input 
      type="number" 
      id="personas" 
      name="personas" 
      min="1" 
      max="6" 
      value="<%= locals.valores && valores.personas ? valores.personas : '' %>"
    >
  </div>

  <button type="submit">Guardar Reserva</button>
</form>